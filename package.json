{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Express API for the Demo Support Tool",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "test:api": "postman collection run \"postman/collections/Demo Support Tool API\" -e postman/environments/local.yaml"
  },
  "dependencies": {
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "mongoose": "9.10.2",
    "morgan": "1.12.1",
    "zod": "4.6.5"
  }
}
