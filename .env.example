# Copy this file to .env and fill in your own values.

# development | production
NODE_ENV=development

# Port the API listens on
PORT=5000

# MongoDB connection string (local install or MongoDB Atlas).
# Atlas example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/demo-support-tool?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/demo-support-tool

# Where the Next.js client runs. Requests from other origins are blocked.
# Separate several origins with commas.
CLIENT_URL=http://localhost:3000

# Secret used to sign login tokens. Use a long random string, e.g. the output of:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# How long a login lasts (e.g. 12h, 7d)
JWT_EXPIRES_IN=7d
