# Copy this file to .env and fill in your own values.

# development | production
NODE_ENV=development

# Port the API listens on
PORT=5000

# MongoDB connection string (local install or MongoDB Atlas).
# Atlas example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/demo-support-tool?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/demo-support-tool

# Where the Next.js client runs. Requests from other origins are blocked.
# The first one is also used for links in emails.
# Separate several origins with commas.
CLIENT_URL=http://localhost:3000

# Secret used to sign login tokens. Use a long random string, e.g. the output of:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# How long a login lasts (e.g. 12h, 7d)
JWT_EXPIRES_IN=7d

# Logins and password changes allowed per IP every 15 minutes; forgot-password emails
# get a quarter of it. Raise it only for automated test runs, which log in many times.
AUTH_RATE_LIMIT=20

# Email, used for forgot-password links. Leave SMTP_HOST empty in development and
# the email is printed in this terminal instead of being sent.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com,
# SMTP_PASS=<a Google "App password", not your normal password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="PharmaZ247 Support <no-reply@example.com>"
